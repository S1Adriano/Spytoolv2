            local tweenSmall = TweenService:Create(countLabel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = originalSize})
            tweenSmall:Play()
        end)
    else
        countLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
    end
    lastPlayerCount = count
end

