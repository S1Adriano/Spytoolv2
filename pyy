local function isFriend(plr)
    if plr == lp then return false end
    local success, result = pcall(function()
        return lp:IsFriendsWith(plr.UserId)
    end)
    return success and result
end

local function getEnemyCount()
    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and not isFriend(plr) then
            count = count + 1
        end
    end
    return count
end

local function updatePlayerCountColor()
    local count = #Players:GetPlayers()
    countLabel.Text = count .. (count == 1 and " Player" or " Players")
    local enemies = getEnemyCount()
    if enemies > 0 then
        countLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        local originalSize = countLabel.Size
        local bigSize = UDim2.fromOffset(240, 68)
        local tweenBig = TweenService:Create(countLabel, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = bigSize})
        tweenBig:Play()
