local function enableESPAll()
    S.ESPenabled = true
    for _, plr in pairs(Players:GetPlayers()) do makeESP(plr) end
    for _, plr in pairs(Players:GetPlayers()) do
        if not playerAddedConns[plr.Name] then
            playerAddedConns[plr.Name] = plr.CharacterAdded:Connect(function()
                task.wait(0.3)
                if S.ESPenabled then
                    task.wait(0.3)
                    if S.ESPenabled then makeESP(plr) end
                end
            end)
        end
    end
end

local function disableESPAll()
    S.ESPenabled = false
    for _, plr in pairs(Players:GetPlayers()) do
        if not soloESPPlayers[plr.Name] then clearESP(plr) end
    end
    for name, conn in pairs(playerAddedConns) do
        conn:Disconnect()
        playerAddedConns[name] = nil
    end
end

local function applyESPTransparency()
    for _, sg in pairs(PARENT:GetChildren()) do
        if sg:IsA("ScreenGui") and sg.Name:find("_SPY_ESP$") then
            for _, child in pairs(sg:GetDescendants()) do
                if child:IsA("Frame") then
                    if child.Name == "" then
                        pcall(function()
                            local parent = child.Parent
                            if parent and parent:IsA("Frame") and parent.Parent and parent.Parent:IsA("ScreenGui") then
                                child.BackgroundTransparency = S.espAlpha
                            elseif parent and parent:IsA("ScreenGui") then
                                child.BackgroundTransparency = math.min(0.15 + S.espAlpha * 0.85, 1)
                            end
                        end)
                    end
                elseif child:IsA("TextLabel") then
                    pcall(function()
                        child.TextStrokeTransparency = math.min(0.2 + S.espAlpha * 0.8, 1)
                    end)
                end
            end
        end
    end
end

