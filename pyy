local function switchPage(pageNum)
    if pageNum == currentPage then return end
    btnSection.Visible = (pageNum == 1)
    page2Frame.Visible = (pageNum == 2)
    page3Frame.Visible = (pageNum == 3)
    for i, btn in pairs(pageButtons) do
        if i == pageNum then
            btn.BackgroundColor3 = C.ACTIVE
            btn.TextColor3 = Color3.new(1,1,1)
        else
            btn.BackgroundColor3 = C.BTN
            btn.TextColor3 = C.SUBTEXT
        end
    end
    currentPage = pageNum
end

for pageNum, btn in pairs(pageButtons) do
    btn.MouseButton1Click:Connect(function()
        switchPage(pageNum)
    end)
end

switchPage(1)

local previewHighlight = nil

local function setPreviewHighlight(plr)
    if previewHighlight and previewHighlight.Parent then previewHighlight:Destroy() end
    previewHighlight = nil
    if not plr or not plr.Character then return end
    previewHighlight = Instance.new("Highlight")
    previewHighlight.Adornee = plr.Character
    previewHighlight.FillColor = Color3.fromRGB(80, 230, 120)
    previewHighlight.FillTransparency = 0.7
    previewHighlight.OutlineColor = Color3.fromRGB(80, 230, 120)
    previewHighlight.OutlineTransparency = 0
    previewHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    previewHighlight.Parent = PARENT
end

local function clearPreviewHighlight()
    if previewHighlight and previewHighlight.Parent then previewHighlight:Destroy() end
    previewHighlight = nil
end

