    end
    updateHint(getHint(cmdBar.Text))
    local cmd, query = parseACInput(cmdBar.Text)
    if cmd then
        showAC(cmd, query)
    else
        clearAC()
    end
end)

local hideTimer = nil

local function isAnyTextboxFocused()
    return cmdBar:IsFocused() or fcSpeedBox:IsFocused() or viewBox:IsFocused() or espTransBox:IsFocused()
end

local function showGUI()
    if hideTimer then task.cancel(hideTimer); hideTimer = nil end
    gui.Visible = true
end

local function scheduleHide()
    if hideTimer then task.cancel(hideTimer) end
    hideTimer = task.delay(2, function()
        if mouseOverGui or isAnyTextboxFocused() or prefixWaiting then
            if mouseOverGui or isAnyTextboxFocused() then
                scheduleHide()
            end
            return
        end
        gui.Visible     = false
        hintBar.Visible = false
        clearAC()
        clearPreviewHighlight()
        hideTimer = nil
    end)
end

