local function showGUI()
    if S.hideTimer then task.cancel(S.hideTimer); S.hideTimer = nil end
    gui.Visible = true
end

local function scheduleHide()
    if S.hideTimer then task.cancel(S.hideTimer) end
    S.hideTimer = task.delay(2, function()
        if isMouseOverGui() or isAnyTextboxFocused() or S.prefixWaiting then
            scheduleHide()
            return
        end
        
        gui.Visible     = false
        hintBar.Visible = false
        clearAC()
        clearPreviewHighlight()
        S.hideTimer = nil
    end)
end

