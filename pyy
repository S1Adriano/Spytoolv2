        local loop = RunService.RenderStepped:Connect(function()
            if not S.ESPenabled and not soloESPPlayers[plr.Name] then
                box.Visible = false; hpBarBg.Visible = false
                return
            end
            if not (sg and sg.Parent) then return end
            
            local currentChar = plr.Character
            if not currentChar or not currentChar.Parent then
                box.Visible = false; hpBarBg.Visible = false
                return
            end
            
            local currentHum = currentChar:FindFirstChildOfClass("Humanoid")
            if not currentHum or not currentHum.Parent or currentHum.Health <= 0 then
                box.Visible = false; hpBarBg.Visible = false
                return
            end
            
            local currentRoot = currentChar:FindFirstChild("HumanoidRootPart")
                or currentChar:FindFirstChild("Torso")
                or currentChar:FindFirstChild("UpperTorso")
            if not currentRoot or not currentRoot.Parent then
                box.Visible = false; hpBarBg.Visible = false
                return
            end

            if not cam or not cam.Parent then
                cam = workspace.CurrentCamera
                if not cam then
                    box.Visible = false; hpBarBg.Visible = false
                    return
                end
            end

            local camPos = cam.CFrame.Position
            local distance = (camPos - currentRoot.Position).Magnitude

            if isLocal and distance < S.LOCAL_ESP_HIDE_DIST then
                box.Visible = false; hpBarBg.Visible = false
                return
            end

            local headPos = currentRoot.Position + Vector3.new(0, 2.8, 0)
            local feetPos = currentRoot.Position - Vector3.new(0, 3.2, 0)

            local hSc, hVis = cam:WorldToViewportPoint(headPos)
            local fSc, fVis = cam:WorldToViewportPoint(feetPos)

            if not hVis or not fVis or hSc.Z < 0 or fSc.Z < 0 then
                box.Visible = false; hpBarBg.Visible = false
                return
            end
            
            box.Visible = true
            hpBarBg.Visible = true

            local screenH = math.abs(hSc.Y - fSc.Y)
            local screenW = screenH * 0.55

            if distance > 50 then
                local farScale = math.max(0.3, 1 - (distance - 50) / 300)
                screenH = screenH * farScale
                screenW = screenW * farScale
            end

            screenH = math.max(screenH, 10)
            screenW = math.max(screenW, 6)

            nameText.Visible = distance > 13
            distText.Visible = distance > 13

            local cx = hSc.X
            local topY = math.min(hSc.Y, fSc.Y)
            local leftX = cx - screenW * 0.5
            local rightX = cx + screenW * 0.5
            local barW = math.max(2, math.floor(screenW * 0.08))

            box.Position = UDim2.new(0, leftX, 0, topY)
            box.Size = UDim2.new(0, screenW, 0, screenH)
            hpBarBg.Position = UDim2.new(0, rightX + 2, 0, topY)
            hpBarBg.Size = UDim2.new(0, barW, 0, screenH)

            local nameSize = math.clamp(math.floor(screenH * 0.08), 6, 12)
            nameText.TextSize = nameSize
            distText.TextSize = nameSize
            distText.Position = UDim2.new(0.5, 0, 0, -(nameSize + 4))

            local hpSize = math.clamp(math.floor(screenH * 0.1), 6, 14)
            hpText.TextSize = hpSize
            hpText.Size = UDim2.new(0, math.max(screenW - 4, 20), 0, hpSize + 2)
            hpText.Position = UDim2.new(1, -2, 1, -2)

            local hp = math.clamp(currentHum.Health, 0, currentHum.MaxHealth)
            local mx = math.max(currentHum.MaxHealth, 1)
            local pct = hp / mx

            hpFill.Size = UDim2.new(1, 0, pct, 0)
            hpFill.Position = UDim2.new(0, 0, 1 - pct, 0)
            
            if isLocal or isMyFriend then
                hpFill.BackgroundColor3 = hpFillColor
            else
                hpFill.BackgroundColor3 = Color3.new(
                    math.clamp(2*(1-pct), 0, 1),
                    math.clamp(2*pct, 0, 1),
                    0
                )
            end
            hpText.Text = math.floor(pct*100) .. "%"
            distText.Text = tostring(math.floor(distance))
        end)

        espLoops[plr.Name] = loop

        local respawnConn
        respawnConn = plr.CharacterAdded:Connect(function(newChar)
            if respawnConn then respawnConn:Disconnect() end
            loop:Disconnect()
            espLoops[plr.Name] = nil
            if sg and sg.Parent then sg:Destroy() end
            task.wait(0.3)
            if S.ESPenabled or soloESPPlayers[plr.Name] then
                task.wait(0.3)
                if S.ESPenabled or soloESPPlayers[plr.Name] then
                    makeESP(plr)
                end
            end
        end)

        plr.AncestryChanged:Connect(function()
            if not plr.Parent then
                if respawnConn then respawnConn:Disconnect() end
                loop:Disconnect()
                espLoops[plr.Name] = nil
                if sg and sg.Parent then sg:Destroy() end
            end
        end)
    end)
end

