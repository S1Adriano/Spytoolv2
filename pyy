UserInputService.InputBegan:Connect(function(input, gp)
    if prefixWaiting then
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local kn   = input.KeyCode.Name
        local skip = {LeftShift=1,RightShift=1,LeftControl=1,RightControl=1,LeftAlt=1,RightAlt=1,
            CapsLock=1,Tab=1,Backspace=1,Delete=1,Return=1,Escape=1,LeftSuper=1,RightSuper=1,
            F1=1,F2=1,F3=1,F4=1,F5=1,F6=1,F7=1,F8=1,F9=1,F10=1,F11=1,F12=1}
        if skip[kn] then return end
        local sm = {Semicolon=";",Period=".",Comma=",",Slash="/",BackSlash="\\",
            Quote="'",LeftBracket="[",RightBracket="]",Minus="-",Equals="=",Tilde="`",Space=" "}
        prefix = sm[kn] or (#kn==1 and kn:lower()) or kn:sub(1,1):lower()
        setPrefixWaiting(false)
        return
    end
    
    if not gp then
        local kn = input.KeyCode.Name
        local sm = {Semicolon=";",Period=".",Comma=",",Slash="/",BackSlash="\\"}
        local ch = sm[kn] or (#kn==1 and kn:lower()) or ""
        if ch == prefix then
            showGUI()
            cmdBar.Text = ""
            wait(0.05)
            cmdBar:CaptureFocus()
            return
        end
    end
    
    if cmdBar:IsFocused() then
        if acFrame.Visible and #acItems > 0 then
            if input.KeyCode == Enum.KeyCode.Up then
                acSelectedIdx = acSelectedIdx - 1
                if acSelectedIdx < 1 then acSelectedIdx = #acItems end
                updateACSelection()
                if acSelectedIdx >= 1 and acSelectedIdx <= #acPlayers then
                    setPreviewHighlight(acPlayers[acSelectedIdx])
                end
            elseif input.KeyCode == Enum.KeyCode.Down then
                acSelectedIdx = acSelectedIdx + 1
                if acSelectedIdx > #acItems then acSelectedIdx = 1 end
                updateACSelection()
                if acSelectedIdx >= 1 and acSelectedIdx <= #acPlayers then
                    setPreviewHighlight(acPlayers[acSelectedIdx])
                end
            elseif input.KeyCode == Enum.KeyCode.Tab then
                if acSelectedIdx >= 1 and acSelectedIdx <= #acPlayers then
                    local plr = acPlayers[acSelectedIdx]
                    cmdBar.Text = acCurrentCmd .. " " .. plr.Name
                    clearAC()
                    clearPreviewHighlight()
                end
            elseif input.KeyCode == Enum.KeyCode.Escape then
                clearAC()
                clearPreviewHighlight()
            end
        end
    end
end)

