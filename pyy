local function getHint(text)
    local t = text:lower():gsub("^%s+","")
    if t:sub(1, #S.prefix) == S.prefix then
        t = t:sub(#S.prefix + 1)
    end
    if t == "" then return "" end
    for _, e in ipairs(cmdHints) do
        local m = t:match(e.p)
        if m ~= nil then return e.h(m) end
    end
    return "Type a command... (press ? for help)"
end

local function execCmd(raw)
    local str   = raw:lower():gsub("^%s+",""):gsub("%s+$","")
    if str == "" then return end
    
    local parts = str:split(" ")
    local cmd, arg1 = parts[1], parts[2]

    if cmd == "esp" then
        if arg1 then
            if arg1 == "all" then
                if S.ESPenabled then disableESPAll(); updateBtn("esp", false)
                else enableESPAll(); updateBtn("esp", true) end
            elseif arg1 == "others" then
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= lp then
                        if not soloESPPlayers[plr.Name] then
                            makeESPSolo(plr)
                        end
                    end
                end
            elseif arg1 == "friends" then
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= lp and isFriend(plr) then
                        if not soloESPPlayers[plr.Name] then
                            makeESPSolo(plr)
                        end
                    end
                end
            elseif arg1 == "bacons" or arg1 == "bacon" then
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= lp and isBacon(plr) then
                        if not soloESPPlayers[plr.Name] then
                            makeESPSolo(plr)
                        end
                    end
                end
            else
                local t = findPlayer(arg1)
                if t then
                    if soloESPPlayers[t.Name] then clearESPSolo(t) else makeESPSolo(t) end
                end
            end
        else
            if S.ESPenabled then disableESPAll(); updateBtn("esp", false)
            else enableESPAll(); updateBtn("esp", true) end
        end
    elseif cmd == "toggleesp" then
        if arg1 then setToggleESPKey(arg1) else setToggleESPKey(nil) end
    elseif cmd == "togglefc" or cmd == "togglefreecam" then
        if arg1 then setToggleFCKey(arg1) else setToggleFCKey(nil) end
    elseif cmd == "togglefly" then
        if arg1 then setToggleFlyKey(arg1) else setToggleFlyKey(nil) end
    elseif cmd == "togglewalkfling" then
        if arg1 then setToggleWalkflingKey(arg1) else setToggleWalkflingKey(nil) end
    elseif cmd == "untogglefly" then
        setToggleFlyKey(nil)
    elseif cmd == "untogglefc" then
        setToggleFCKey(nil)
    elseif cmd == "untoggleesp" then
        setToggleESPKey(nil)
    elseif cmd == "toggleaurakey" then
        if arg1 then setToggleAuraKey(arg1) else setToggleAuraKey(nil) end
    elseif cmd == "untoggleaura" then
        setToggleAuraKey(nil)
    elseif cmd == "esptransparency" or cmd == "espt" then
        local v = tonumber(arg1)
        if v then S.espAlpha = math.clamp(v, 0.01, 0.95); applyESPTransparency() end
    elseif cmd == "unesp" then
        if arg1 then
            local t = findPlayer(arg1)
            if t then clearESPSolo(t) end
        else
            disableESPAll(); updateBtn("esp", false)
            soloESPPlayers = {}
            for _, plr in pairs(Players:GetPlayers()) do clearESP(plr) end
        end
    elseif cmd == "view" or cmd == "spectate" then
        local t = findPlayer(arg1 or "")
        if t then startView(t) end
    elseif cmd == "unview" or cmd == "unspectate" then
        stopView()
    elseif cmd == "freecam" or cmd == "fc" then
        startFreecam(); wait(0.05); updateBtn("fc", S.fcRunning)
    elseif cmd == "unfreecam" or cmd == "unfc" then
        stopFreecam(); updateBtn("fc", false)
    elseif cmd == "fcspeed" or cmd == "freecamspeed" then
        local v = tonumber(arg1)
        if v then FCInput.SetSpeed(v) end
    elseif cmd == "fb" or cmd == "fullbright" then
        setFullbright(true); updateBtn("fb", true)
    elseif cmd == "unfb" or cmd == "nofullbright" then
        setFullbright(false); updateBtn("fb", false)
    elseif cmd == "fixcam" then
        stopFreecam(); stopView()
        Camera.CameraType    = Enum.CameraType.Custom
        Camera.FieldOfView   = 70
        Camera.CameraSubject = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
        updateBtn("fc", false)
    elseif cmd == "rejoin" or cmd == "rj" then
        doRejoin()
    elseif cmd == "day"   then Lighting.ClockTime = 14
    elseif cmd == "night" then Lighting.ClockTime = 0
    elseif cmd == "nofog" then Lighting.FogEnd = 100000
    elseif cmd == "copyname" then
        if arg1 then
            local t = findPlayer(arg1)
            if t then doCopyName(t) end
        end
    elseif cmd == "antilag" or cmd == "boostfps" or cmd == "lowgraphics" then
        doAntilag()
    elseif cmd == "abuse" then
        setAbuseMode(true)
    elseif cmd == "unabuse" then
        setAbuseMode(false)
    elseif cmd == "soakill" then
        if not S.abuseMode then return end
        if arg1 then
            local t = findPlayer(arg1)
            if t then doSoaKill(t) end
        end
    elseif cmd == "fling" then
        if not S.abuseMode then return end
        if arg1 then
            local t = findPlayer(arg1)
            if t then doFling(t) end
        end
    elseif cmd == "fling2" then
        if not S.abuseMode then return end
        if arg1 then
            local t = findPlayer(arg1)
            if t then doFling2(t) end
        end
    elseif cmd == "walkfling" then
        if not S.abuseMode then return end
        startWalkfling()
        showNotify("Walkfling: ON", C.ABUSE)
    elseif cmd == "unwalkfling" or cmd == "nowalkfling" then
        if not S.abuseMode then return end
        stopWalkfling()
        showNotify("Walkfling: OFF", C.SUBTEXT)
    elseif cmd == "goto" then
        if not S.abuseMode then return end
        if arg1 then
            local t = findPlayer(arg1)
            if t then doGoto(t) end
        end
    elseif cmd == "aimbot" then
        if not S.abuseMode then return end
        doAimbot()
    elseif cmd == "ia" then
        if not S.abuseMode then return end
        doIA()
    elseif cmd == "vanehub" then
        if not S.abuseMode then return end
        print("coming soon")
    elseif cmd == "aura" or cmd == "toggleaura" then
        if not S.abuseMode then return end
        toggleAura()
    elseif cmd == "noaura" or cmd == "unaura" then
        if not S.abuseMode then return end
        stopAura()
        showNotify("Aura: OFF", C.SUBTEXT)
    elseif cmd == "aurareach" then
        if not S.abuseMode then return end
        local v = tonumber(arg1)
        if v then
            setAuraReach(v)
        end
    elseif cmd == "aurapart" then
        if not S.abuseMode then return end
        if arg1 then
            setAuraPart(arg1)
        end
    elseif cmd == "rspy" or cmd == "remotespy" then
        if not S.abuseMode then return end
        doRspy()
    elseif cmd == "simplespy" then
        if not S.abuseMode then return end
        doSimpleSpy()
    elseif cmd == "jerk" then
        if not S.abuseMode then return end
        doJerk()
    elseif cmd == "fly" then
        if not S.abuseMode then return end
        if FlyS.flying then
            stopFly()
            showNotify("Fly: OFF", C.SUBTEXT)
        else
            startFly()
            showNotify("Fly: ON", C.ABUSE)
        end
    elseif cmd == "unfly" or cmd == "nofly" then
        if not S.abuseMode then return end
        if FlyS.flying then
            stopFly()
            showNotify("Fly: OFF", C.SUBTEXT)
        end
    elseif cmd == "flyspeed" or cmd == "flyws" then
        if not S.abuseMode then return end
        local v = tonumber(arg1)
        if v and v > 0 then
            setFlySpeed(v)
        end
    elseif cmd == "playercount" or cmd == "pcount" then
        S.showPlayerCount = not S.showPlayerCount
        playerCountGui.Enabled = S.showPlayerCount
        updatePlayerCountColor()
        showNotify(S.showPlayerCount and "Player Count: ON" or "Player Count: OFF", S.showPlayerCount and C.SUCCESS or C.SUBTEXT)
    elseif cmd == "ignorenpcs" or cmd == "nonpcs" or cmd == "npcsoff" then
        S.ignoreNpcs = true
        showNotify("NPC ESP: OFF", C.SUBTEXT)
    elseif cmd == "unignorenpcs" or cmd == "npcs" or cmd == "npcson" then
        S.ignoreNpcs = false
        showNotify("NPC ESP: ON", C.SUCCESS)
    end
end

