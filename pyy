local function GetFocusDistance(cf)
    local znear   = 0.1
    local vp      = Camera.ViewportSize
    local projy   = 2 * math.tan(math.rad(cameraFov/2))
    local projx   = vp.X / vp.Y * projy
    local minDist = 512
    for x = 0,1,0.5 do for y = 0,1,0.5 do
        local offset = cf.RightVector*(x-.5)*projx - cf.UpVector*(y-.5)*projy + cf.LookVector
        local _, hit = workspace:FindPartOnRay(Ray.new(cf.Position + offset.Unit*znear, offset.Unit*minDist))
        local d = (hit - cf.Position).Magnitude
        if d < minDist then minDist = d end
    end end
    return cf.LookVector:Dot(cf.LookVector) * minDist
end

local function StepFreecam(dt)
    local clampedDt = math.min(dt, 1/30)
    local vel = velSpring:Update(clampedDt, FCInput.Vel(clampedDt))
    local pan = panSpring:Update(clampedDt, FCInput.Pan(clampedDt))
    local zoom = math.sqrt(math.tan(math.rad(70/2)) / math.tan(math.rad(cameraFov/2)))
    cameraRot = cameraRot + pan * Vector2.new(0.75,1) * 8 * (clampedDt/zoom)
    cameraRot = Vector2.new(math.clamp(cameraRot.X,-math.rad(90),math.rad(90)), cameraRot.Y%(2*math.pi))
    local newCF = CFrame.new(cameraPos) * CFrame.fromOrientation(cameraRot.X, cameraRot.Y, 0) * CFrame.new(vel*64*clampedDt)
    cameraPos = newCF.Position
    Camera.CFrame = newCF
    Camera.Focus  = newCF * CFrame.new(0,0,-GetFocusDistance(newCF))
    Camera.FieldOfView = cameraFov
end

local freecamClickConn = nil
local flyToConn = nil
local flyTarget = nil
local flyTargetPlayer = nil

local function stopFlyTo()
    if flyToConn then flyToConn:Disconnect(); flyToConn = nil end
    flyTarget = nil
    flyTargetPlayer = nil
end

local function flyToPosition(targetPos, lookAtPos)
    if flyToConn then flyToConn:Disconnect(); flyToConn = nil end
    flyTarget = targetPos
    local startPos = cameraPos
    local startPitch = cameraRot.X
    local targetPitch = startPitch
    if lookAtPos then
        local dir = lookAtPos - targetPos
        local horizontalDist = math.sqrt(dir.X * dir.X + dir.Z * dir.Z)
        targetPitch = math.atan2(dir.Y, horizontalDist)
        targetPitch = math.clamp(targetPitch, -math.rad(60), math.rad(10))
    end
    local duration = 0.5
    local elapsed = 0
    flyToConn = RunService.RenderStepped:Connect(function(dt)
        if not fcRunning or flyTarget ~= targetPos then
            if flyToConn then flyToConn:Disconnect(); flyToConn = nil end
            return
        end
        elapsed = elapsed + dt
        local progress = math.min(elapsed / duration, 1)
        local eased = progress < 0.5 and 2 * progress * progress or 1 - math.pow(-2 * progress + 2, 2) / 2
        cameraPos = startPos:Lerp(targetPos, eased)
        cameraRot = Vector2.new(startPitch + (targetPitch - startPitch) * eased, cameraRot.Y)
        if progress >= 1 then
            flyToConn:Disconnect(); flyToConn = nil; flyTarget = nil
        end
    end)
end

local FC_FOV_ANGLE = 70
local FC_HEIGHT_OFFSET = 4
local FC_BEHIND_OFFSET = 6

local function getPlayerInFOV()
    local cam = workspace.CurrentCamera
    local camPos = cam.CFrame.Position
    local camLook = cam.CFrame.LookVector
    local bestPlayer = nil
    local bestAngle = math.rad(FC_FOV_ANGLE / 2)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
                or p.Character:FindFirstChild("Torso")
                or p.Character:FindFirstChild("UpperTorso")
            if root then
                local toPlayer = (root.Position - camPos).Unit
                local angle = math.acos(math.clamp(camLook:Dot(toPlayer), -1, 1))
                if angle < bestAngle then bestAngle = angle; bestPlayer = p end
            end
        end
    end
    return bestPlayer
end

local function enableFreecamClickThrough()
    if freecamClickConn then return end
    freecamClickConn = UserInputService.InputBegan:Connect(function(input, gp)
        if not fcRunning then return end
        if gp then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        local targetPlayer = getPlayerInFOV()
        if targetPlayer and targetPlayer.Character then
            local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                or targetPlayer.Character:FindFirstChild("Torso")
                or targetPlayer.Character:FindFirstChild("UpperTorso")
            if root then
                local cam = workspace.CurrentCamera
                local behindDir = -cam.CFrame.LookVector
                local behindOffset = Vector3.new(behindDir.X * FC_BEHIND_OFFSET, 0, behindDir.Z * FC_BEHIND_OFFSET)
                local targetPos = root.Position + Vector3.new(0, FC_HEIGHT_OFFSET, 0) + behindOffset
                flyToPosition(targetPos, root.Position)
                flyTargetPlayer = targetPlayer
            end
        end
    end)
end

local function disableFreecamClickThrough()
    if freecamClickConn then freecamClickConn:Disconnect(); freecamClickConn = nil end
    stopFlyTo()
end

local function stopFreecam()
    if not fcRunning then return end
    disableFreecamClickThrough()
    FCInput.StopCapture()
    RunService:UnbindFromRenderStep("SpyFreecam")
    PlayerState.Pop()
    fcRunning = false
end

local function startFreecam(pos)
    if fcRunning then stopFreecam() return end
    cameraFov = Camera.FieldOfView
    cameraPos = (pos or Camera.CFrame).Position
    cameraRot = Vector2.new()
    velSpring:Reset(Vector3.new()); panSpring:Reset(Vector2.new())
    PlayerState.Push()
    RunService:BindToRenderStep("SpyFreecam", Enum.RenderPriority.Camera.Value, StepFreecam)
    FCInput.StartCapture()
    fcRunning = true
    enableFreecamClickThrough()
end

