local function updateAllNpcEsp()
    if not S.ESPenabled or S.ignoreNpcs then
        clearNpcEsp()
        return
    end
    
    local allNpcs = getCachedNpcs()
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local validKeys = {}
    
    for _, entry in pairs(allNpcs) do
        local npc = entry.model
        local uniqueKey = npc:GetFullName()
        validKeys[uniqueKey] = true
        
        if entry.hum and entry.hum.Health > 0 then
            if not npcEspBoxes[uniqueKey] then
                createNpcEsp(npc)
            end
        end
    end
    
    for uniqueKey, data in pairs(npcEspBoxes) do
        local npc = data.npc
        
        if not validKeys[uniqueKey] or not npc or not npc.Parent then
            if data.sg and data.sg.Parent then
                data.sg:Destroy()
            end
            npcEspBoxes[uniqueKey] = nil
        else
            local npcHum = npc:FindFirstChildWhichIsA("Humanoid", true)
            local npcRoot = npc:FindFirstChild("HumanoidRootPart", true) or npc:FindFirstChild("Torso", true) or npc:FindFirstChild("UpperTorso", true)
            
            if npcHum and npcRoot and npcHum.Health > 0 then
                local headPos = npcRoot.Position + Vector3.new(0, 2.8, 0)
                local feetPos = npcRoot.Position - Vector3.new(0, 3.2, 0)
                
                local hSc, hVis = cam:WorldToViewportPoint(headPos)
                local fSc, fVis = cam:WorldToViewportPoint(feetPos)
                
                if hVis and fVis and hSc.Z > 0 and fSc.Z > 0 then
                    data.box.Visible = true
                    data.hpBarBg.Visible = true
                    
                    local screenH = math.abs(hSc.Y - fSc.Y)
                    local screenW = screenH * 0.55
                    
                    local distance = (cam.CFrame.Position - npcRoot.Position).Magnitude
                    
                    if distance > 50 then
                        local farScale = math.max(0.3, 1 - (distance - 50) / 300)
                        screenH = screenH * farScale
                        screenW = screenW * farScale
                    end
                    
                    screenH = math.max(screenH, 10)
                    screenW = math.max(screenW, 6)
                    
                    data.nameText.Visible = distance > 13
                    data.distText.Visible = distance > 13
                    
                    local cx = hSc.X
                    local topY = math.min(hSc.Y, fSc.Y)
                    local leftX = cx - screenW * 0.5
                    local rightX = cx + screenW * 0.5
                    local barW = math.max(2, math.floor(screenW * 0.08))
                    
                    data.box.Position = UDim2.new(0, leftX, 0, topY)
                    data.box.Size = UDim2.new(0, screenW, 0, screenH)
                    data.hpBarBg.Position = UDim2.new(0, rightX + 2, 0, topY)
                    data.hpBarBg.Size = UDim2.new(0, barW, 0, screenH)
                    
                    local nameSize = math.clamp(math.floor(screenH * 0.08), 6, 12)
                    data.nameText.TextSize = nameSize
                    data.distText.TextSize = nameSize
                    data.distText.Position = UDim2.new(0.5, 0, 0, -(nameSize + 4))
                    
                    local hpSize = math.clamp(math.floor(screenH * 0.1), 6, 14)
                    data.hpText.TextSize = hpSize
                    data.hpText.Size = UDim2.new(0, math.max(screenW - 4, 20), 0, hpSize + 2)
                    data.hpText.Position = UDim2.new(1, -2, 1, -2)
                    
                    local hp = math.clamp(npcHum.Health, 0, npcHum.MaxHealth)
                    local mx = math.max(npcHum.MaxHealth, 1)
                    local pct = hp / mx
                    
                    data.hpFill.Size = UDim2.new(1, 0, pct, 0)
                    data.hpFill.Position = UDim2.new(0, 0, 1 - pct, 0)
                    
                    data.hpFill.BackgroundColor3 = Color3.new(
                        math.clamp(2*(1-pct), 0, 1),
                        math.clamp(2*pct, 0, 1),
                        0
                    )
                    
                    data.hpText.Text = math.floor(pct*100) .. "%"
                    data.distText.Text = tostring(math.floor(distance))
                else
                    data.box.Visible = false
                    data.hpBarBg.Visible = false
                end
            else
                data.box.Visible = false
                data.hpBarBg.Visible = false
            end
        end
    end
end

