local function startFly()
    if not S.abuseMode then return end
    if FlyS.flying then return end
    local char = lp.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local T2 = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not humanoid or not T2 then return end
    
    FlyS.flying = true
    FlyS.BG = Instance.new("BodyGyro")
    FlyS.BV = Instance.new("BodyVelocity")
    FlyS.BG.P = 9e4
    FlyS.BG.Parent = T2
    FlyS.BV.Parent = T2
    FlyS.BG.MaxTorque = Vector3.new(9e9,9e9,9e9)
    FlyS.BG.CFrame = T2.CFrame
    FlyS.BV.Velocity = Vector3.new(0,0,0)
    FlyS.BV.MaxForce = Vector3.new(9e9,9e9,9e9)
    
    FlyS.flyThread = task.spawn(function()
        while FlyS.flying and FlyS.BG and FlyS.BV do
            task.wait()
            local camera = workspace.CurrentCamera
            if humanoid then humanoid.PlatformStand = true end
            local CONTROL = FlyS.control
            local SPEED = BASE_FLY_SPEED * FlyS.flySpeed
            if (CONTROL.L+CONTROL.R)~=0 or (CONTROL.F+CONTROL.B)~=0 or (CONTROL.Q+CONTROL.E)~=0 then
                FlyS.BV.Velocity = ((camera.CFrame.LookVector*(CONTROL.F+CONTROL.B)) + ((camera.CFrame*CFrame.new(CONTROL.L+CONTROL.R,(CONTROL.F+CONTROL.B+CONTROL.Q+CONTROL.E)*0.2,0).p) - camera.CFrame.p))*SPEED
            else
                FlyS.BV.Velocity = Vector3.new(0,0,0)
            end
            if FlyS.BG then FlyS.BG.CFrame = camera.CFrame end
        end
    end)
    
    FlyS.flyKeyDown = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.W then FlyS.control.F = 1
        elseif input.KeyCode == Enum.KeyCode.S then FlyS.control.B = -1
        elseif input.KeyCode == Enum.KeyCode.A then FlyS.control.L = -1
        elseif input.KeyCode == Enum.KeyCode.D then FlyS.control.R = 1
        elseif input.KeyCode == Enum.KeyCode.E then FlyS.control.Q = 1
        elseif input.KeyCode == Enum.KeyCode.Q then FlyS.control.E = -1 end
    end)
    
    FlyS.flyKeyUp = UserInputService.InputEnded:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.W then FlyS.control.F = 0
        elseif input.KeyCode == Enum.KeyCode.S then FlyS.control.B = 0
        elseif input.KeyCode == Enum.KeyCode.A then FlyS.control.L = 0
        elseif input.KeyCode == Enum.KeyCode.D then FlyS.control.R = 0
        elseif input.KeyCode == Enum.KeyCode.E then FlyS.control.Q = 0
        elseif input.KeyCode == Enum.KeyCode.Q then FlyS.control.E = 0 end
    end)
    
    startNoclip()
end

local function stopFly()
    FlyS.flying = false
    if FlyS.flyKeyDown then FlyS.flyKeyDown:Disconnect(); FlyS.flyKeyDown = nil end
    if FlyS.flyKeyUp then FlyS.flyKeyUp:Disconnect(); FlyS.flyKeyUp = nil end
    if FlyS.flyThread then task.cancel(FlyS.flyThread); FlyS.flyThread = nil end
    
    if FlyS.BG and FlyS.BG.Parent then FlyS.BG:Destroy() end
    if FlyS.BV and FlyS.BV.Parent then FlyS.BV:Destroy() end
    FlyS.BG = nil
    FlyS.BV = nil
    
    local char = lp.Character
