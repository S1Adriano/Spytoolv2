local function findPlayer(query)
    if not query or query == "" then return nil end
    query = query:lower()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name:lower():sub(1,#query) == query or
           plr.DisplayName:lower():sub(1,#query) == query then
            return plr
        end
    end
end

-- ========== SOAKILL (funciona en cualquier juego con el remote) ==========
local function doSoaKill(target)
    local char = target.Character
    if not char then return false end
    
    local ok, err = pcall(function()
        -- Buscar el remote event paso a paso
        local RS = game:GetService("ReplicatedStorage")
        if not RS then return end
        
        local Connections = RS:FindFirstChild("Connections")
        if not Connections then return end
        
        local Event = Connections:FindFirstChild("HotWheeIs")
        if not Event then return end
        
