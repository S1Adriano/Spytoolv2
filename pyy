        hpText.Font                   = Enum.Font.GothamBold
        hpText.TextSize               = 10
        hpText.TextColor3             = espColor
        hpText.TextStrokeTransparency = math.min(0.2 + currentAlpha * 0.8, 1)
        hpText.TextStrokeColor3       = Color3.new(0,0,0)
        hpText.TextXAlignment         = Enum.TextXAlignment.Right
        hpText.ZIndex                 = 4
        hpText.Text                   = "100%"
        hpText.Parent                 = box

        local nameText = Instance.new("TextLabel")
        nameText.BackgroundTransparency = 1
        nameText.AnchorPoint            = Vector2.new(0.5, 1)
        nameText.Position = UDim2.new(0.5, 0, 0, -2)
        nameText.Size = UDim2.new(1, 0, 0, 14)
        nameText.Font = Enum.Font.GothamBold
        nameText.TextSize = 10
        nameText.TextColor3 = espColor
        nameText.TextStrokeTransparency = math.min(0.2 + currentAlpha * 0.8, 1)
        nameText.TextStrokeColor3 = Color3.new(0,0,0)
        nameText.TextXAlignment = Enum.TextXAlignment.Center
        nameText.ZIndex = 4
        nameText.Text = plr.Name
        nameText.Parent = box

        local hpBarBg = Instance.new("Frame")
        hpBarBg.BackgroundColor3       = Color3.fromRGB(20,20,20)
        hpBarBg.BackgroundTransparency = math.min(0.15 + currentAlpha * 0.85, 1)
        hpBarBg.BorderSizePixel        = 0
        hpBarBg.ZIndex                 = 2
        hpBarBg.Parent                 = sg

        local hpFill = Instance.new("Frame")
        hpFill.BackgroundColor3 = hpFillColor
        hpFill.BorderSizePixel  = 0
        hpFill.AnchorPoint      = Vector2.new(0,0)
        hpFill.Position         = UDim2.new(0,0,0,0)
        hpFill.Size             = UDim2.new(1,0,1,0)
        hpFill.ZIndex           = 3
        hpFill.Parent           = hpBarBg

        local cam = workspace.CurrentCamera

        local loop = RunService.RenderStepped:Connect(function()
            if not ESPenabled and not soloESPPlayers[plr.Name] then
                sg.Enabled = false
                return
            end
            if not (sg and sg.Parent) then return end
            if not (char and char.Parent and hum and hum.Parent and root and root.Parent) then
                sg.Enabled = false
                return
            end

            local camPos = cam.CFrame.Position
            local distance = (camPos - root.Position).Magnitude

            if isLocal and distance < LOCAL_ESP_HIDE_DIST then
                sg.Enabled = false
                return
            end

            nameText.Visible = distance > 13

            local headPos = root.Position + Vector3.new(0, 2.8, 0)
            local feetPos = root.Position - Vector3.new(0, 3.2, 0)

            local hSc, hVis = cam:WorldToViewportPoint(headPos)
            local fSc       = cam:WorldToViewportPoint(feetPos)

            if not hVis or hSc.Z < 0 then
                sg.Enabled = false
                return
            end
            sg.Enabled = true

            local screenH = math.max(math.abs(hSc.Y - fSc.Y), 10)
            local screenW = screenH * 0.55
            local cx      = hSc.X
            local topY    = math.min(hSc.Y, fSc.Y)
            local leftX   = cx - screenW * 0.5
            local rightX  = cx + screenW * 0.5
            local barW    = math.max(2, math.floor(screenW * 0.08))

            box.Position     = UDim2.new(0, leftX,     0, topY)
            box.Size         = UDim2.new(0, screenW,    0, screenH)

            hpBarBg.Position = UDim2.new(0, rightX + 2, 0, topY)
            hpBarBg.Size     = UDim2.new(0, barW,        0, screenH)

            local hpSize = math.clamp(math.floor(screenH * 0.1), 6, 14)
            hpText.TextSize = hpSize
            hpText.Size = UDim2.new(1, -4, 0, hpSize + 2)
            hpText.Position = UDim2.new(1, -2, 1, -2)
            nameText.TextSize = math.clamp(math.floor(screenH * 0.08), 6, 12)

            local hp  = math.clamp(hum.Health, 0, hum.MaxHealth)
            local mx  = math.max(hum.MaxHealth, 1)
            local pct = hp / mx

            hpFill.Size             = UDim2.new(1, 0, pct, 0)
            hpFill.Position         = UDim2.new(0, 0, 1 - pct, 0)
            if not isLocal then
                hpFill.BackgroundColor3 = Color3.new(
                    math.clamp(2*(1-pct), 0, 1),
                    math.clamp(2*pct,     0, 1),
                    0
                )
            end
            hpText.Text = math.floor(pct*100) .. "%"
        end)

        espLoops[plr.Name] = loop

        plr.CharacterAdded:Connect(function()
            loop:Disconnect()
            espLoops[plr.Name] = nil
            if sg and sg.Parent then sg:Destroy() end
            wait(1)
            if ESPenabled or soloESPPlayers[plr.Name] then
                makeESP(plr)
            end
        end)
    end)
end

