local function startWalkfling()
    if S.walkflingActive then return end
    
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end
    
    S.walkflingNoclipConn = RunService.Stepped:Connect(function()
        local c = lp.Character
        if not c then return end
        for _, v in pairs(c:GetChildren()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end)
    
    S.walkflingActive = true
    
    S.walkflingThread = task.spawn(function()
        repeat RunService.Heartbeat:Wait()
            local character = lp.Character
            local root = getRoot(character)
            local vel, movel = nil, 0.1

            while not (character and character.Parent and root and root.Parent) do
                RunService.Heartbeat:Wait()
                character = lp.Character
                root = getRoot(character)
            end

            vel = root.Velocity
            root.Velocity = vel * 20000 + Vector3.new(0, 20000, 0)

            RunService.RenderStepped:Wait()
            if character and character.Parent and root and root.Parent then
                root.Velocity = vel
            end

            RunService.Stepped:Wait()
            if character and character.Parent and root and root.Parent then
                root.Velocity = vel + Vector3.new(0, movel, 0)
                movel = movel * -1
            end
        until S.walkflingActive == false
        
        if S.walkflingNoclipConn then
            S.walkflingNoclipConn:Disconnect()
            S.walkflingNoclipConn = nil
        end
        local c = lp.Character
        if c then
            for _, v in pairs(c:GetChildren()) do
                if v:IsA("BasePart") then
                    v.CanCollide = true
                end
            end
        end
    end)
