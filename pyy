    end
    acSelectedIdx = 1
    updateACSelection()
    acFrame.Visible = true
end

local PLAYER_CMDS = {"view","spectate","esp","unesp","soakill","fling","goto","copyname","aimbot"}

local function parseACInput(text)
    local t = text:lower():gsub("^%s+","")
    for _, c in pairs(PLAYER_CMDS) do
        if t:sub(1,#c+1) == c.." " then
            local query = t:sub(#c+2)
            if not query:find(" ") then
                return c, query
            end
