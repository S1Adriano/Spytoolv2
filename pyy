        return
    end
    local specialKeys = {[";"]="Semicolon",["."]="Period",[","]="Comma",["/"]="Slash",["\\"]="BackSlash"}
    local keyCode
    if specialKeys[keyName] then
        keyCode = Enum.KeyCode[specialKeys[keyName]]
    elseif #keyName == 1 then
        keyCode = Enum.KeyCode[keyName:upper()]
    else
        local ok, kc = pcall(function() return Enum.KeyCode[keyName] end)
        if ok and kc then keyCode = kc end
    end
    if not keyCode then return end
    T.WalkflingKey = #keyName == 1 and keyName:lower() or keyName
    T.WalkflingConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if cmdBar:IsFocused() then return end
        if input.KeyCode == keyCode then
            toggleWalkfling()
        end
    end)
end

local function predictPosition(targetRoot, predictTime)
    if not targetRoot or not targetRoot.Parent then return nil end
    local vel = targetRoot.Velocity
    if vel.Magnitude < 1 then
        return targetRoot.Position
    end
    return targetRoot.Position + vel * predictTime
end

