local function showAC(cmd, query)
    clearAC()
    acCurrentCmd = cmd
    local q = (query or ""):lower()
    local matches = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == lp and (cmd == "view" or cmd == "spectate") then continue end
        local name = plr.Name
        local display = plr.DisplayName
        if name:lower():find(q, 1, true) or display:lower():find(q, 1, true) then
            table.insert(matches, plr)
        end
    end
    table.sort(matches, function(a,b)
        local aDisplay = a.DisplayName:lower()
        local bDisplay = b.DisplayName:lower()
        if aDisplay ~= bDisplay then return aDisplay < bDisplay end
        return a.Name:lower() < b.Name:lower()
    end)
    if #matches == 0 then return end

    local shown = math.min(#matches, AC_MAX_ITEMS)
    local itemH = 22
    acFrame.Size = UDim2.new(1,0,0,shown*itemH + (shown-1)*2 + 4)

    for i = 1, shown do
        local plr = matches[i]
        local btn = Instance.new("TextButton")
        btn.BackgroundColor3 = C.BTN
        btn.BorderSizePixel  = 0
        btn.Size             = UDim2.new(1,-4,0,itemH)
        btn.Font             = Enum.Font.SourceSans
        btn.TextSize         = 12
        btn.TextColor3       = C.TEXT
        btn.TextXAlignment   = Enum.TextXAlignment.Left
        btn.AutoButtonColor  = false
        btn.ZIndex           = 21
        btn.Parent           = acFrame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0,2)

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0,6)
        pad.Parent = btn

        local label = plr.Name
        if plr.DisplayName ~= plr.Name then
            label = plr.Name .. "  ·  " .. plr.DisplayName
        end
        btn.Text = label

        btn.MouseEnter:Connect(function()
            acSelectedIdx = i
            updateACSelection()
        end)
        btn.MouseButton1Click:Connect(function()
            cmdBar.Text = cmd .. " " .. plr.Name
            clearAC()
            task.spawn(function() cmdBar:CaptureFocus() end)
        end)
        table.insert(acItems, btn)
        table.insert(acPlayers, plr)
    end
    acSelectedIdx = 1
    updateACSelection()
    acFrame.Visible = true
end

