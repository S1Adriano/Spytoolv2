-- AURA CON "PULL" - usa cache (sin scan por frame, sin lag)
-- ============================================================
local function getAuraHitPosition(partPos, playerHeadPos, distance)
    if distance <= AuraS.pullStart then
        return partPos
    end
    local pull = math.min(distance - AuraS.pullStart, AuraS.pullMax)
    local dirToMe = (playerHeadPos - partPos).Unit
    return partPos + dirToMe * pull
end

local function startAura()
    if AuraS.active then return end
    
    cacheMeleeEvents()
    if not MeleeEvents.Hit then return end
    
    AuraS.active = true
    
    AuraS.loopConn = RunService.RenderStepped:Connect(function()
        if not AuraS.active then
            if AuraS.loopConn then
                AuraS.loopConn:Disconnect()
                AuraS.loopConn = nil
            end
            return
        end
        
        local ev = MeleeEvents.Hit
        if not ev then
            stopAura()
            return
        end
        
        local char = lp.Character
        if not char then return end
        
        local playerHead = char:FindFirstChild("Head")
        if not playerHead or not playerHead:IsA("BasePart") then return end
        
        -- usa la lista cacheada (scan con cooldown), misma velocidad de pegado
        local allNpcs = getCachedNpcs()
        for _, entry in ipairs(allNpcs) do
            local hum = entry.hum
            local root = entry.root
            if hum and hum.Parent and hum.Health > 0 and root and root.Parent then
                local part = entry.part
                if part and part:IsA("BasePart") and part.Parent then
                    local partPos = part.Position
                    local distance = (playerHead.Position - partPos).Magnitude
                    if distance <= AuraS.reach then
                        local hitPos = getAuraHitPosition(partPos, playerHead.Position, distance)
                        local swingEv = MeleeEvents.Swing
                        if swingEv then
                            pcall(function() swingEv:InvokeServer() end)
                        end
                        ev:FireServer(part, hitPos)
                    end
                end
            end
        end
    end)
end

local function stopAura()
    AuraS.active = false
    if AuraS.loopConn then
        AuraS.loopConn:Disconnect()
        AuraS.loopConn = nil
    end
end

local function toggleAura()
    if AuraS.active then
        stopAura()
        if showNotify then showNotify("Aura: OFF", C.SUBTEXT) end
    else
        startAura()
        if showNotify then showNotify("Aura: ON", C.ABUSE) end
    end
end

local function setAuraReach(n)
    AuraS.reach = math.clamp(tonumber(n) or 21, 1, 30)
end

local function setAuraPart(partName)
    local validParts = {"head", "torso", "arms", "legs"}
    local lowerPart = partName:lower()
    for _, valid in ipairs(validParts) do
        if lowerPart:sub(1, #valid) == valid then
            if valid == "head" then AuraS.aimPart = "Head"
            elseif valid == "torso" then AuraS.aimPart = "Torso"
            elseif valid == "arms" then AuraS.aimPart = "Arms"
            elseif valid == "legs" then AuraS.aimPart = "Legs"
            end
            return true
        end
    end
    return false
end

local function setToggleAuraKey(keyName)
    if T.AuraConn then T.AuraConn:Disconnect(); T.AuraConn = nil end
    if not keyName or keyName == "" then
        T.AuraKey = nil
        return
    end
    local specialKeys = {[";"]="Semicolon",["."]="Period",[","]="Comma",["/"]="Slash",["\\"]="BackSlash"}
    local keyCode
    if specialKeys[keyName] then
        keyCode = Enum.KeyCode[specialKeys[keyName]]
    elseif #keyName == 1 then
        keyCode = Enum.KeyCode[keyName:upper()]
    else
        local ok, kc = pcall(function() return Enum.KeyCode[keyName] end)
        if ok and kc then keyCode = kc end
    end
    if not keyCode then return end
    T.AuraKey = #keyName == 1 and keyName:lower() or keyName
    T.AuraConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if cmdBar:IsFocused() then return end
        if input.KeyCode == keyCode then
            toggleAura()
        end
    end)
end

