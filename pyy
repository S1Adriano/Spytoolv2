-- ========== FLY + NOCLIP ==========
local flyState = {
    flying = false,
    flyKeyDown = nil,
    flyKeyUp = nil,
    control = {F=0,B=0,L=0,R=0,Q=0,E=0},
    noclipConn = nil,
    noclipParts = {},
    flyThread = nil,
    BG = nil,
    BV = nil,
    flySpeed = 150
}

local function startNoclip()
    if flyState.noclipConn then flyState.noclipConn:Disconnect() end
    flyState.noclipParts = {}
    flyState.noclipConn = RunService.Stepped:Connect(function()
        local char = lp.Character
        if char then
            for _, child in pairs(char:GetDescendants()) do
                if child:IsA("BasePart") and child.CanCollide == true then
                    child.CanCollide = false
                    flyState.noclipParts[child] = true
                end
            end
        end
    end)
end

local function stopNoclip()
    if flyState.noclipConn then flyState.noclipConn:Disconnect(); flyState.noclipConn = nil end
    for child, _ in pairs(flyState.noclipParts) do
        if typeof(child) == "Instance" and child:IsA("BasePart") and child.Parent then
            child.CanCollide = true
        end
    end
    flyState.noclipParts = {}
end

local function startFly()
    if flyState.flying then return end
    local char = lp.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local T = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not humanoid or not T then return end
    
    flyState.flying = true
    flyState.BG = Instance.new("BodyGyro")
    flyState.BV = Instance.new("BodyVelocity")
    flyState.BG.P = 9e4
    flyState.BG.Parent = T
    flyState.BV.Parent = T
    flyState.BG.MaxTorque = Vector3.new(9e9,9e9,9e9)
    flyState.BG.CFrame = T.CFrame
    flyState.BV.Velocity = Vector3.new(0,0,0)
    flyState.BV.MaxForce = Vector3.new(9e9,9e9,9e9)
    
    flyState.flyThread = task.spawn(function()
        while flyState.flying and flyState.BG and flyState.BV do
            task.wait()
            local camera = workspace.CurrentCamera
            if humanoid then humanoid.PlatformStand = true end
            local CONTROL = flyState.control
            local SPEED = flyState.flySpeed
            if (CONTROL.L+CONTROL.R)~=0 or (CONTROL.F+CONTROL.B)~=0 or (CONTROL.Q+CONTROL.E)~=0 then
                flyState.BV.Velocity = ((camera.CFrame.LookVector*(CONTROL.F+CONTROL.B)) + ((camera.CFrame*CFrame.new(CONTROL.L+CONTROL.R,(CONTROL.F+CONTROL.B+CONTROL.Q+CONTROL.E)*0.2,0).p) - camera.CFrame.p))*SPEED
            else
                flyState.BV.Velocity = Vector3.new(0,0,0)
            end
            if flyState.BG then flyState.BG.CFrame = camera.CFrame end
        end
    end)
    
    flyState.flyKeyDown = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.W then flyState.control.F = 1
        elseif input.KeyCode == Enum.KeyCode.S then flyState.control.B = -1
        elseif input.KeyCode == Enum.KeyCode.A then flyState.control.L = -1
        elseif input.KeyCode == Enum.KeyCode.D then flyState.control.R = 1
        elseif input.KeyCode == Enum.KeyCode.E then flyState.control.Q = 1
        elseif input.KeyCode == Enum.KeyCode.Q then flyState.control.E = -1 end
    end)
    
    flyState.flyKeyUp = UserInputService.InputEnded:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.W then flyState.control.F = 0
        elseif input.KeyCode == Enum.KeyCode.S then flyState.control.B = 0
        elseif input.KeyCode == Enum.KeyCode.A then flyState.control.L = 0
        elseif input.KeyCode == Enum.KeyCode.D then flyState.control.R = 0
        elseif input.KeyCode == Enum.KeyCode.E then flyState.control.Q = 0
        elseif input.KeyCode == Enum.KeyCode.Q then flyState.control.E = 0 end
    end)
    
    startNoclip()
end

local function stopFly()
    flyState.flying = false
    if flyState.flyKeyDown then flyState.flyKeyDown:Disconnect(); flyState.flyKeyDown = nil end
    if flyState.flyKeyUp then flyState.flyKeyUp:Disconnect(); flyState.flyKeyUp = nil end
    if flyState.flyThread then task.cancel(flyState.flyThread); flyState.flyThread = nil end
    
    if flyState.BG and flyState.BG.Parent then flyState.BG:Destroy() end
    if flyState.BV and flyState.BV.Parent then flyState.BV:Destroy() end
    flyState.BG = nil
    flyState.BV = nil
    
    local char = lp.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.PlatformStand = false end
    end
    
    flyState.control = {F=0,B=0,L=0,R=0,Q=0,E=0}
    stopNoclip()
end

local function setFlySpeed(speed)
    flyState.flySpeed = speed
end

