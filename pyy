local function clearESP(plr)
    if espLoops[plr.Name] then
        espLoops[plr.Name]:Disconnect()
        espLoops[plr.Name] = nil
    end
    for _, v in pairs(PARENT:GetChildren()) do
        if v.Name == plr.Name .. "_SPY_ESP" then v:Destroy() end
    end
end

local function makeESP(plr)
    if not ESPenabled and not soloESPPlayers[plr.Name] then return end
    clearESP(plr)
    task.spawn(function()
        local char = plr.Character or plr.CharacterAdded:Wait()
        if not ESPenabled and not soloESPPlayers[plr.Name] then return end
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local root = char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("UpperTorso")
        if not root then return end

        local isLocal = (plr == lp)
        local espColor = isLocal and Color3.fromRGB(80, 230, 120) or Color3.new(1,1,1)
        local hpFillColor = isLocal and Color3.fromRGB(80, 230, 120) or Color3.fromRGB(80,220,80)

        local currentAlpha = espAlpha

        local sg = Instance.new("ScreenGui")
        sg.Name           = plr.Name .. "_SPY_ESP"
        sg.ResetOnSpawn   = false
        sg.IgnoreGuiInset = true
        sg.DisplayOrder   = 999
        sg.Parent         = PARENT

        local box = Instance.new("Frame")
        box.BackgroundTransparency = 1
        box.BorderSizePixel        = 0
        box.ZIndex                 = 2
        box.Parent                 = sg

        local thick = 1
        local t = Instance.new("Frame")
        t.BackgroundColor3 = espColor; t.BackgroundTransparency = currentAlpha; t.BorderSizePixel = 0; t.ZIndex = 3
        t.Position = UDim2.new(0,0,0,0); t.Size = UDim2.new(1,0,0,thick); t.Parent = box

        local b = Instance.new("Frame")
        b.BackgroundColor3 = espColor; b.BackgroundTransparency = currentAlpha; b.BorderSizePixel = 0; b.ZIndex = 3
        b.Position = UDim2.new(0,0,1,-thick); b.Size = UDim2.new(1,0,0,thick); b.Parent = box

        local l = Instance.new("Frame")
        l.BackgroundColor3 = espColor; l.BackgroundTransparency = currentAlpha; l.BorderSizePixel = 0; l.ZIndex = 3
        l.Position = UDim2.new(0,0,0,0); l.Size = UDim2.new(0,thick,1,0); l.Parent = box

        local r = Instance.new("Frame")
        r.BackgroundColor3 = espColor; r.BackgroundTransparency = currentAlpha; r.BorderSizePixel = 0; r.ZIndex = 3
        r.Position = UDim2.new(1,-thick,0,0); r.Size = UDim2.new(0,thick,1,0); r.Parent = box

