local NPC_SCAN_COOLDOWN = 1 -- segundos entre scans

local npcCache = {
    list = {},        -- lista de entries {model, hum, root, part}
    lastScan = -math.huge,
    aimPartCached = nil,
}

-- recursion con GetChildren (nunca GetDescendants)
local function collectNpcsRecursive(folder, out)
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") then
            local h = child:FindFirstChildWhichIsA("Humanoid", true)
            if h then
                out[child] = true
                -- no entrar al modelo (el rig interno es del mismo NPC)
            else
                collectNpcsRecursive(child, out)
            end
        elseif child:IsA("Folder") then
            collectNpcsRecursive(child, out)
        end
    end
end

local function findFolders(root, path, index)
    if index > #path then
        return {root}
    end
    local found = {}
    local targetName = path[index]
    for _, child in ipairs(root:GetChildren()) do
        if child.Name == targetName and (child:IsA("Folder") or child:IsA("Model")) then
            local sub = findFolders(child, path, index + 1)
            for _, s in ipairs(sub) do
                table.insert(found, s)
            end
        end
    end
    return found
end

local function getAuraTargetPart(npc)
    local partName = AuraS.aimPart
    
    if partName == "Head" then
        local head = npc:FindFirstChild("Head", true)
        if head and head:IsA("BasePart") then return head end
        local torso = npc:FindFirstChild("Torso", true) or npc:FindFirstChild("UpperTorso", true)
        if torso and torso:IsA("BasePart") then return torso end
        return nil
    elseif partName == "Torso" then
        local torso = npc:FindFirstChild("Torso", true) or npc:FindFirstChild("UpperTorso", true)
        if torso and torso:IsA("BasePart") then return torso end
        return nil
    elseif partName == "Arms" then
        local leftArm = npc:FindFirstChild("Left Arm", true) or npc:FindFirstChild("LeftHand", true)
        local rightArm = npc:FindFirstChild("Right Arm", true) or npc:FindFirstChild("RightHand", true)
        if leftArm and leftArm:IsA("BasePart") then return leftArm end
        if rightArm and rightArm:IsA("BasePart") then return rightArm end
        local torso = npc:FindFirstChild("Torso", true) or npc:FindFirstChild("UpperTorso", true)
        if torso and torso:IsA("BasePart") then return torso end
        return nil
    elseif partName == "Legs" then
        local leftLeg = npc:FindFirstChild("Left Leg", true) or npc:FindFirstChild("LeftFoot", true)
        local rightLeg = npc:FindFirstChild("Right Leg", true) or npc:FindFirstChild("RightFoot", true)
        if leftLeg and leftLeg:IsA("BasePart") then return leftLeg end
        if rightLeg and rightLeg:IsA("BasePart") then return rightLeg end
        local torso = npc:FindFirstChild("Torso", true) or npc:FindFirstChild("UpperTorso", true)
        if torso and torso:IsA("BasePart") then return torso end
        return nil
    end
    
    return nil
end

local function scanNpcs()
    cacheMeleeEvents()
    
    local found = {}
    for _, path in ipairs(NPC_PATHS) do
        local folders = findFolders(workspace, path, 1)
        for _, folder in ipairs(folders) do
            collectNpcsRecursive(folder, found)
        end
    end
    
    local list = {}
    for model, _ in pairs(found) do
        local h = model:FindFirstChildWhichIsA("Humanoid", true)
        if h and h.Health > 0 then
            local root = model:FindFirstChild("HumanoidRootPart", true)
                or model:FindFirstChild("Torso", true)
                or model:FindFirstChild("UpperTorso", true)
            local part = getAuraTargetPart(model) or root
            table.insert(list, { model = model, hum = h, root = root, part = part })
        end
    end
    
    npcCache.list = list
    npcCache.lastScan = os.clock()
    npcCache.aimPartCached = AuraS.aimPart
end

local function getCachedNpcs(force)
    local needRescan = force
        or (os.clock() - npcCache.lastScan >= NPC_SCAN_COOLDOWN)
        or (npcCache.aimPartCached ~= AuraS.aimPart)
    if needRescan then
        scanNpcs()
    end
    return npcCache.list
end

